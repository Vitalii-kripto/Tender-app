# Скопируйте этот файл в .env и заполните своими значениями

# ===== ОБЯЗАТЕЛЬНО =====
# Ключ Google Gemini API
API_KEY=ВАШ_КЛЮЧ_СЮДА

# Внутренний ключ для защиты backend API
INTERNAL_API_KEY=придумайте-длинный-случайный-ключ-минимум-32-символа

# ===== BACKEND =====
HOST=0.0.0.0
PORT=8000
LEGAL_AI_DEBUG=false

# CORS: список разрешённых origin через запятую
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://tender-app-liard.vercel.app

# ===== FRONTEND =====
# true = мок-данные, false = реальный backend
VITE_DEMO_MODE=false

# URL backend API для frontend
VITE_API_URL=http://localhost:8000

# ===== AI =====
# Модель Gemini (не менять без необходимости)
GEMINI_MODEL=gemini-3-flash-preview
